{
  "name": "yanshu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "雁书 YanShu 前端（Vue 3 + Vite）：端侧加密 → 中转 → 端侧解密",
  "scripts": {
    "build": "vite build",
    "check": "node --test tests/*.test.js && vite build",
    "dev": "vite",
    "dev:stub": "VITE_YS_CRYPTO=stub-fake vite",
    "evidence:ui": "node scripts/v4-evidence.mjs",
    "evidence:v5": "node scripts/v5-evidence.mjs",
    "prebuild": "node scripts/ensure-wasm.mjs",
    "pretest": "node scripts/ensure-wasm.mjs",
    "preview": "vite preview",
    "relay": "node relay/dev-relay.mjs",
    "siginput:check": "node scripts/check-siginput.mjs",
    "siginput:dump": "node scripts/dump-siginput.mjs",
    "test": "node --test tests/*.test.js",
    "typecheck": "vue-tsc --noEmit",
    "wasm:check": "node scripts/check-wasm.mjs",
    "wasm:rebuild": "node scripts/rebuild-wasm.mjs",
    "wasm:sync": "node scripts/sync-wasm.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.10"
  }
}
