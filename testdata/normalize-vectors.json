    {"in": "O0IL", "out": "0011", "ok": true, "idempotent": true},
    {"in": "0oO0", "out": "0000", "ok": true, "idempotent": true},
    {"in": "awqw", "out": "AWQW", "ok": true, "idempotent": true},
