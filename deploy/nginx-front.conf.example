# 雁书 · 前置反向代理示例（外层 nginx，CDN 终止 TLS）
#
# 真实拓扑：客户端 → CDN（终止 TLS）→ 本机 nginx(:80) → 容器 web(:18080 → 内层 nginx → 服务端)
#
# 放置：/etc/nginx/conf.d/yanshu.conf（或 sites-available + 软链）
#
# 硬前提（不满足会让限速/配额/大文件全部失真）：
#   1) 本文件只监听 80 —— TLS 由 CDN 终止，机器上不放证书；
#      只有「客户端直连本机、不经过 CDN」时才需要下面注释掉的 443 段。
#   2) X-Forwarded-For 的取值取决于 CDN：
#      - CDN 会写自己的客户端 IP 头（Cloudflare：CF-Connecting-IP；阿里云 CDN：Ali-CDN-Real-IP）→ 用方案 A；
#      - CDN 只写/覆盖 X-Forwarded-For → 用方案 B（透传）。
#      服务端只取 XFF 的**第一跳（最左）**，所以写进去的值必须是最左那个。
#   3) `map` 只能写在 `http {}` 层（本文件由 conf.d 的 http 上下文 include，所以这里的 map 合法）；
#      不要把它塞进 `server {}`，否则 nginx 起不来。

# ---- 方案 A：优先用 CDN 提供的客户端 IP 头（推荐）----
# 没有该头（例如本机直连调试）时回落到 $remote_addr。
map $http_cf_connecting_ip $ys_client_ip_a {
    default $http_cf_connecting_ip;
    ""      $remote_addr;
}

# 阿里云 CDN 用这个头；按你实际用的 CDN 取消注释其一即可。
# map $http_ali_cdn_real_ip $ys_client_ip_a {
#     default $http_ali_cdn_real_ip;
#     ""      $remote_addr;
# }

# ---- 方案 B：CDN 只写 X-Forwarded-For，这里原样透传 ----
# 若无该头（直连本机），回落到 $remote_addr。
map $http_x_forwarded_for $ys_client_ip_b {
    default $http_x_forwarded_for;
    ""      $remote_addr;
}

server {
    listen 80;
    server_name _;                      # 换成你的域名

    # 上传体积：内层已 32m，外层不得小于它（CDN 侧同样要放大，见 docs/DEPLOY.md）
    client_max_body_size 32m;
    client_body_timeout  300s;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        # 真实客户端 IP：二选一（默认方案 A）。服务端取 XFF 第一跳，故这里直接赋值。
        proxy_set_header X-Real-IP         $ys_client_ip_a;
        proxy_set_header X-Forwarded-For   $ys_client_ip_a;
        # 方案 B（CDN 只写 XFF 时）：
        # proxy_set_header X-Real-IP       $ys_client_ip_b;
        # proxy_set_header X-Forwarded-For $ys_client_ip_b;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host              $host;

        # 大文件上传/下载：关闭缓冲，放宽超时
        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_connect_timeout   10s;
        proxy_send_timeout      300s;
        proxy_read_timeout      300s;

        # Range 透传（分段下载）
        proxy_set_header Range    $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_force_ranges on;
    }

    # WebSocket：v1 **未启用**（/v1/ws 只是 503 占位）。
    # 真启用时再加下面三行（含 http 层的 $connection_upgrade map）：
    #   map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    #   proxy_set_header Upgrade    $http_upgrade;
    #   proxy_set_header Connection $connection_upgrade;
}

# ---- 可选：客户端直连本机（不经过 CDN）时才需要 ----
# 此时必须自己终止 TLS，并注意上面的 XFF 方案要改成 $remote_addr 直取。
# server {
#     listen 443 ssl;
#     http2 on;
#     server_name _;
#     ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#     # 其余 location 与 80 段保持一致
# }
