# 复制成 .env 后按需修改：cp .env.example .env
# 必填：>=16 字节的随机串（缺它 compose 会直接报错退出）
YANSHU_TOKEN_SECRET=
# 数据库口令：必填（缺失 compose 直接报错退出）。生成：openssl rand -hex 12
# 注意：改它只会影响新建库；已有 pgdata 卷请 `docker compose down -v` 后重建，或手动改库内口令。
POSTGRES_PASSWORD=
# 对外端口
YANSHU_PORT=18080
# token 密钥版本：轮换时 +1，旧版本 token 立即失效（全量吊销）
YANSHU_TOKEN_EPOCH=1
# 镜像标签（正式版用 latest 或具体版本号）
YANSHU_IMAGE_TAG=latest
